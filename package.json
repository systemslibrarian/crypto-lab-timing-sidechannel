    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
